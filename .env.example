# Wodouh — server-side secrets, in one place.
#
# WHAT THIS FILE IS FOR. Everything below is read by Supabase Edge Functions
# via Deno.env.get(). They were previously discoverable only by grepping four
# function files, which is how a deployment ends up missing one and failing at
# runtime instead of at setup.
#
# HOW TO USE IT. Do NOT copy this to .env and expect it to work — Edge
# Functions do not read a local .env in production. Set each one as a Supabase
# function secret from your own machine:
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set ALLOWED_ORIGIN=https://alwodouh.com
#
# A local `.env` is useful only for `supabase functions serve` during
# development. Either way this file is the checklist.
#
# NOTHING HERE BELONGS IN THE BROWSER. The browser's configuration is
# supabase/config.example.js — copy that to supabase/config.js (gitignored).
# The two files are separate on purpose: everything in config.js is public by
# design, and everything here is not.


# ── Injected automatically by Supabase. Do not set these yourself. ──────────
# SUPABASE_URL                 the project's API URL
# SUPABASE_SERVICE_ROLE_KEY    BYPASSES ROW LEVEL SECURITY. It is available to
#                              Edge Functions and must never appear in the
#                              repo, in app/, or in web/. If it ever leaks,
#                              rotate it immediately in the dashboard.


# ── Required for the AI features (analyze, upload) ─────────────────────────
# Without ANTHROPIC_API_KEY the analyze function returns 503 not_configured
# and the app renders no AI surface at all — that is the shipping default and
# it is deliberate, not a broken state.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5, which is what the contract analysis
# is written and tested against.
ANTHROPIC_MODEL=

# The exact origin allowed to call the functions. Not a wildcard: these
# endpoints spend money and read user data.
#   production  https://alwodouh.com
#   local dev   http://127.0.0.1:8099
ALLOWED_ORIGIN=


# ── Required only for the Zid / Salla integrations (0002_integrations.sql) ──
# Leave blank unless you are wiring a storefront. The OAuth callback needs to
# know where it lives and where to send the merchant back to.
FUNCTION_BASE_URL=
APP_URL=

# Signs the OAuth `state` parameter, which is what stops a forged callback
# attaching someone else's store to your account. Any long random string:
#   openssl rand -base64 48
OAUTH_STATE_SECRET=


# ── Tap Payments — Saudi card checkout. Leave blank to stay unconfigured. ──
# With TAP_SECRET_KEY empty, create-payment and tap-webhook return 503
# not_configured and the app does not charge anyone. FREE_NOW is unchanged.
# Never put the secret key in app/, supabase/config.js, or the browser.
#
# Keys live in the Tap dashboard (goSell → API Credentials) for the account
# that already receives payments. A pending deposit setup does not block
# creating a sandbox charge. Live percentage fees are a quote from Tap —
# do not invent them.
#
# PAYMENT_MODE defaults to test inside the functions when this is unset.
# test refuses an sk_live_ key, and live refuses an sk_test_ key.
#   supabase secrets set PAYMENT_MODE=test
#   supabase secrets set TAP_SECRET_KEY=sk_test_...
PAYMENT_MODE=test
TAP_SECRET_KEY=
# Public key (pk_test_… / pk_live_…). Safe to expose if you later embed
# Tap's card SDK. This integration uses a hosted charge, so the browser
# never needs it. If you set it, it must be the same mode as the secret key.
TAP_PUBLIC_KEY=
# Optional. Tap signs hashstring with the secret API key. Leave this empty
# so verification uses TAP_SECRET_KEY. Set it only if Tap gave you a
# different signing secret — a random value rejects every real webhook.
TAP_WEBHOOK_SECRET=
