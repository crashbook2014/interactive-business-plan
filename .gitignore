node_modules/

# Agent and human scratch. Playwright drivers have to sit inside the repo to
# reach test/_env.js and the installed playwright, so a review pass leaves
# throwaway .mjs files behind. They were showing up as uncommitted product
# changes, which is how real uncommitted work gets lost in the noise.
.walk/
scratch/
_*.mjs

supabase/config.js
supabase/.env
.env
.env.*
# ...but the CHECKLIST is meant to be committed. Without this negation the
# pattern above swallows it silently: `git add .env.example` appears to work
# and the file never lands, which is how a repo ends up with no documented
# setup at all.
!.env.example
*.p8
